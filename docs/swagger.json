                "description": "Retrieve a list of bookmarks for the authenticated user with pagination and sorting",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Bookmarks"
                ],
                "summary": "List bookmarks",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "example": 1,
                        "description": "Page number",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 5,
                        "example": 5,
                        "description": "Number of items per page",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "default": "-createdAt",
                        "example": "-createdAt,description",
                        "description": "Sorting criteria(",
                        "name": "sort",
                        "in": "query"
                    }
